<h1>Data Bulan</h1>
<a href="/admin/bulan/create" class="btn btn-primary mb-3">Tambah Bulan</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nama Bulan</th>
            <th>Deskripsi</th>
            <th>Created At</th>
            <th>Aksi</th>
        </tr>
    </thead>
    <tbody>
        <% bulan.forEach(b => { %>
            <tr>
                <td><%= b.id %></td>
                <td><%= b.nama_bulan %></td>
                <td><%= b.deskripsi %></td>
                <td><%= b.created_at.toLocaleString() %></td>
                <td>
                    <a href="/admin/bulan/edit/<%= b.id %>" class="btn btn-warning btn-sm">Edit</a>
                    <a href="/admin/bulan/delete/<%= b.id %>" class="btn btn-danger btn-sm">Hapus</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>
