<div class="container py-4">

    <!-- ===========================
         1. HEADER DASHBOARD
    ============================ -->
    <div class="mb-4">
        <h2 class="fw-bold">Dashboard Kalender & Artikel Informasi</h2>
        <p class="text-muted">
            Informasi terbaru tentang artikel kalender, hari besar nasional, internasional, dan update libur terbaru.
        </p>
    </div>

    <!-- ===========================
         2. STATISTIK UTAMA
    ============================ -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="stat-card">
                <h5 class="mb-1"><i class="bi bi-journal-text me-2"></i>Total Artikel</h5>
                <h3 class="fw-bold"><%= stats.totalArtikel %></h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <h5><i class="bi bi-flag me-2"></i>Hari Besar Nasional</h5>
                <h3 class="fw-bold"><%= stats.hariNasional %></h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <h5><i class="bi bi-globe2 me-2"></i>Hari Besar Internasional</h5>
                <h3 class="fw-bold"><%= stats.hariInternasional %></h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <h5><i class="bi bi-airplane me-2"></i>Rekomendasi Bulan Ini</h5>
                <h3 class="fw-bold"><%= stats.rekomendasiBulan %></h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <h5><i class="bi bi-megaphone me-2"></i>Update Libur Tambahan</h5>
                <h3 class="fw-bold"><%= stats.updateLibur %></h3>
            </div>
        </div>

    </div>

    <!-- ===========================
         3. KALENDER MINI
    ============================ -->
    <div class="calendar-box">

        <h4 class="fw-bold mb-3">
            <i class="bi bi-calendar3 me-2"></i>Kalender Bulan <%= calendarInfo.bulan %>
        </h4>

        <% calendarInfo.eventBulanIni.forEach(e => { %>
            <div class="calendar-date <%= e.tanggal === calendarInfo.hariIni ? 'today' : '' %>">
                <strong><%= e.tanggal %></strong> — <%= e.nama %>
            </div>
        <% }) %>

    </div>
